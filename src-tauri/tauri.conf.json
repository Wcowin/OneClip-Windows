{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneClip",
  "version": "1.0.0",
  "identifier": "cloud.oneclip.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OneClip",
        "width": 400,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false,
        "minWidth": 320,
        "minHeight": 400
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "shortDescription": "智能剪贴板管理工具",
    "longDescription": "OneClip 是一款专为效率而生的剪贴板管理工具，支持历史记录、智能分类、快捷回复等功能。"
  },
  "plugins": {
    "clipboard-manager": {},
    "global-shortcut": {},
    "autostart": {
      "macosLaunchAgent": false
    },
    "notification": {}
  }
}
